<Window x:Class="MxBacklightControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MX Backlight Control"
        Width="470"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        FontFamily="Segoe UI">

    <Border Margin="10"
            Background="{StaticResource BgPrimary}"
            BorderBrush="{StaticResource BorderSubtle}"
            BorderThickness="1"
            CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="6" Opacity="0.55"/>
        </Border.Effect>

        <StackPanel Margin="20,16,20,20">
            <!-- Custom Title Bar -->
            <Grid MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Background="Transparent" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource AccentCyanSoft}" Margin="0,0,10,0">
                        <TextBlock Text="MX" FontWeight="Bold" FontSize="12" Foreground="{StaticResource AccentCyan}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="MX Backlight Control" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="Logitech HID++ Arka Işık Kontrolü" FontSize="11"
                                   Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource TitleBarButton}" Content="—" ToolTip="Tepsiye Küçült"
                            Click="MinimizeButton_Click" Margin="0,0,4,0"/>
                    <Button Style="{StaticResource TitleBarButton}" Content="✕" ToolTip="Kapat"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- Connected Device Card -->
            <Border Background="{StaticResource BgCard}"
                    BorderBrush="{StaticResource BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14"
                    Margin="0,0,0,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Device Title + Status Dot -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource StatusAmber}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource StatusGreen}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding DeviceName}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- Reconnect Button -->
                    <Button Grid.Row="0" Grid.Column="1"
                            Style="{StaticResource TitleBarButton}"
                            Command="{Binding ReconnectCommand}"
                            Content="↻" FontSize="15" ToolTip="Klavyeyi Yeniden Tara"/>

                    <!-- Telemetry Pills -->
                    <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0">
                        <Border Background="#232733" CornerRadius="6" Padding="8,4" Margin="0,0,6,4">
                            <TextBlock FontSize="11.5" Foreground="{StaticResource TextSecondary}">
                                <Run Text="Bağlantı: "/>
                                <Run Text="{Binding ConnectionLabel, Mode=OneWay}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold"/>
                            </TextBlock>
                        </Border>
                        <Border Background="#232733" CornerRadius="6" Padding="8,4" Margin="0,0,6,4">
                            <TextBlock FontSize="11.5" Foreground="{StaticResource TextSecondary}">
                                <Run Text="Pil: "/>
                                <Run Text="{Binding BatteryLabel, Mode=OneWay}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold"/>
                            </TextBlock>
                        </Border>
                        <Border Background="#232733" CornerRadius="6" Padding="8,4" Margin="0,0,0,4">
                            <TextBlock FontSize="11.5" Foreground="{StaticResource TextSecondary}">
                                <Run Text="Işık: "/>
                                <Run Text="{Binding HardwareLevelLabel, Mode=OneWay}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold"/>
                            </TextBlock>
                        </Border>
                    </WrapPanel>

                    <!-- Protocol info -->
                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2"
                               Text="{Binding ProtocolLabel}"
                               FontSize="10.5"
                               Foreground="#6E778B"
                               Margin="0,6,0,0"/>
                </Grid>
            </Border>

            <!-- Mode Selector Section -->
            <TextBlock Text="ARKA IŞIK MODU" FontSize="11" FontWeight="SemiBold"
                       Foreground="{StaticResource TextSecondary}" Margin="2,0,0,8"/>

            <UniformGrid Columns="3" Margin="0,0,0,10">
                <!-- Always On -->
                <Button Command="{Binding SetAlwaysOnCommand}" Margin="0,0,6,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ModeCardButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAlwaysOn}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource AccentCyanSoft}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentCyan}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="☀" FontSize="22" HorizontalAlignment="Center" Margin="0,0,0,6">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAlwaysOn}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource AccentCyan}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="Sürekli Açık" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Always On" FontSize="10.5" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>

                <!-- Always Off -->
                <Button Command="{Binding SetAlwaysOffCommand}" Margin="3,0,3,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ModeCardButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAlwaysOff}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource AccentOffSoft}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentOff}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="⏻" FontSize="22" HorizontalAlignment="Center" Margin="0,0,0,6">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAlwaysOff}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource AccentOff}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="Sürekli Kapalı" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Always Off" FontSize="10.5" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>

                <!-- Auto / Default -->
                <Button Command="{Binding SetAutoCommand}" Margin="6,0,0,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ModeCardButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAuto}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource AccentIndigoSoft}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentIndigo}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="✦" FontSize="22" HorizontalAlignment="Center" Margin="0,0,0,6">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAuto}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource AccentIndigo}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="Otomatik" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Varsayılan" FontSize="10.5" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>
            </UniformGrid>

            <!-- Active Mode Explanation Banner -->
            <Border Background="#181B22" CornerRadius="10" Padding="12,9" Margin="0,0,0,14"
                    BorderBrush="#252A36" BorderThickness="1">
                <TextBlock Text="{Binding ActiveModeSubtitle}" FontSize="11.5"
                           Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
            </Border>

            <!-- Settings Card -->
            <TextBlock Text="AYARLAR" FontSize="11" FontWeight="SemiBold"
                       Foreground="{StaticResource TextSecondary}" Margin="2,0,0,8"/>

            <Border Background="{StaticResource BgCard}"
                    BorderBrush="{StaticResource BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14">
                <StackPanel>
                    <!-- Keep-Alive Interval Slider (for Always On) -->
                    <Grid Margin="0,0,0,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Canlı Tutma Yenileme Aralığı (Sürekli Açık)"
                                   FontSize="12.5" Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding KeepAliveLabel}"
                                   FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource AccentCyan}"/>

                        <Slider Grid.Row="1" Grid.ColumnSpan="2"
                                Minimum="2" Maximum="180" TickFrequency="1" IsSnapToTickEnabled="True"
                                Value="{Binding KeepAliveIntervalSeconds}"
                                Margin="0,6,0,0"/>

                        <TextBlock Grid.Row="2" Grid.ColumnSpan="2"
                                   Text="Pil modunda 3–4 sn, USB kablo takılıyken 60–180 sn önerilir."
                                   FontSize="10.5" Foreground="#6E778B" Margin="0,4,0,0"/>
                    </Grid>

                    <!-- Brightness Section (Interactive on 0x1982 v3, Live Read-Only on 0x1982 v1) -->
                    <Grid Margin="0,0,0,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Parlaklık Seviyesi"
                                   FontSize="12.5" Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding HardwareLevelLabel}"
                                   FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource AccentCyan}"/>

                        <Slider Grid.Row="1" Grid.ColumnSpan="2"
                                Minimum="0" Maximum="7" TickFrequency="1" IsSnapToTickEnabled="True"
                                IsEnabled="{Binding SupportsManualBrightnessSlider}"
                                Value="{Binding DisplayBrightnessLevel}"
                                Margin="0,6,0,0"/>

                        <TextBlock Grid.Row="2" Grid.ColumnSpan="2"
                                   Text="{Binding BrightnessHintText}"
                                   FontSize="10.5" Foreground="#6E778B" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </Grid>

                    <Separator Background="{StaticResource BorderSubtle}" Margin="0,0,0,12"/>

                    <CheckBox Style="{StaticResource ToggleSwitch}"
                              Content="Kapatınca sistem tepsisinde çalışmaya devam et"
                              IsChecked="{Binding MinimizeToTray}"
                              Margin="0,0,0,10"/>

                    <CheckBox Style="{StaticResource ToggleSwitch}"
                              Content="Windows başlangıcında otomatik başlat"
                              IsChecked="{Binding LaunchAtStartup}"
                              Margin="0,0,0,10"/>

                    <CheckBox Style="{StaticResource ToggleSwitch}"
                              Content="Global kısayol tuşu (Ctrl + Alt + L)"
                              IsChecked="{Binding EnableGlobalHotkey}"/>
                </StackPanel>
            </Border>

            <!-- Footer Status Bar -->
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="11"
                       Foreground="#7C8599"
                       Margin="4,12,4,0"
                       TextTrimming="CharacterEllipsis"/>
        </StackPanel>
    </Border>
</Window>
